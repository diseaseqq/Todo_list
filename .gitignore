# Локальные настройки и секреты
.env
.env.*
!.env.example

# Composer и зависимости PHP
/vendor/
/composer.phar

# Локальные данные приложения и SQLite
/storage/*
!/storage/.gitkeep
/var/cache/
/var/log/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Журналы, временные файлы и кэш тестов/анализаторов
*.log
*.tmp
*.cache
/.phpunit.cache/
/coverage/
/.phpunit.result.cache
/.phpstan.cache/
/.php-cs-fixer.cache

# Frontend-зависимости и результаты сборки, если появятся
/node_modules/
/dist/
/build/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Локальные настройки редакторов
.idea/
.vscode/

# Файлы ОС
.DS_Store
Thumbs.db
Desktop.ini
